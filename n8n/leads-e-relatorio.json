    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "COLE_AQUI_O_ID_DA_PLANILHA" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "options": {}
      },
      "id": "c3f0c003-0000-4000-8000-000000000007",
      "name": "Ler planilha",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 260]
    },
    {
      "parameters": {
        "jsCode": "// Resume os leads dos últimos 7 dias.\nconst inicio = $now.minus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst leads = $input.all().map((i) => i.json).filter((l) => l.Data >= inicio);\nconst contar = (campo) => Object.entries(leads.reduce((m, l) => (m[l[campo]] = (m[l[campo]] || 0) + 1, m), {}))\n  .sort((a, b) => b[1] - a[1]).map(([k, v]) => `- ${k}: ${v}`).join('\\n');\nconst agendou = leads.filter((l) => l.Status === 'Agendou').length;\nconst semContato = leads.filter((l) => l.Status === 'Novo').map((l) => l.Nome);\nconst texto = `Leads da semana: ${leads.length}\\nViraram agendamento: ${agendou}\\n\\nPor interesse:\\n${contar('Interesse')}\\n\\nPor origem:\\n${contar('Origem')}\\n\\n` +\n  (semContato.length ? `Ainda sem contato: ${semContato.join(', ')}` : 'Todos os leads foram contatados.');\nreturn [{ json: { texto } }];"
      },
      "id": "c3f0c003-0000-4000-8000-000000000008",
      "name": "Resumir a semana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 260]
    },
    {
      "parameters": {
        "sendTo": "recepcao@exemplo.com",
        "subject": "Relatório semanal de leads",
        "emailType": "text",
        "message": "={{ $json.texto }}",
        "options": {}
      },
      "id": "c3f0c003-0000-4000-8000-000000000009",
      "name": "Enviar relatório",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, 260]
    }
  ],
