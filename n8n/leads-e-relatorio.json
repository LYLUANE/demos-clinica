      "id": "c3f0c003-0000-4000-8000-000000000003",
      "name": "Planilha: nova linha",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Formulário do site').item.json.body.email }}",
        "subject": "Recebemos seu pedido de avaliação 😊",
        "emailType": "text",
        "message": "=Olá, {{ $('Formulário do site').item.json.body.nome.split(' ')[0] }}!\n\nRecebemos seu interesse em {{ $('Formulário do site').item.json.body.interesse.toLowerCase() }}. Nossa equipe vai entrar em contato hoje para combinar o melhor horário.\n\nAté breve,\nEquipe Clínica Aurora",
        "options": {}
