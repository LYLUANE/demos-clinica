        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: '5511900000000', type: 'text', text: { body: 'Novo lead: ' + $('Formulário do site').item.json.body.nome + ' (' + $('Formulário do site').item.json.body.interesse + ', via ' + $('Formulário do site').item.json.body.origem + ')' } }) }}",
        "options": {}
